{
  "name": "rajista-pay",
  "version": "0.1.0",
  "description": "Take USDC at a shop till on Solana: on-chain bills that can only be paid once, for the agreed naira price, into the owner's account.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "rajista-pay": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Risingtell/rajista-pay.git"
  },
  "keywords": [
    "solana",
    "usdc",
    "point-of-sale",
    "solana-pay",
    "nigeria",
    "naira"
  ],
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@solana/web3.js": "^1.98.4",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.0"
  }
}
